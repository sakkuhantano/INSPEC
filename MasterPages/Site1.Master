<div class="d-flex align-items-center gap-2">
<div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 32px; height: 32px; background-color: var(--primary-container);">
<i class="bi bi-person-circle"></i>
