<!-- Sync Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index:1100;">

    <div id="syncToast"
         class="toast air-shadow border-0"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">

        <!-- HEADER -->
        <div class="toast-header bg-white border-0 py-2">

            <!-- Spinner -->
            <div id="syncSpinner"
                 class="spinner-border spinner-border-sm text-primary me-2"
                 role="status">
                <span class="visually-hidden">
                    Loading...
                </span>

            </div>

            <!-- Title -->
            <strong class="me-auto text-primary small fw-bold">

                Synchronizing

            </strong>

            <!-- Close Button -->
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="toast"
                    aria-label="Close">
            </button>

        </div>

        <!-- BODY -->
        <div class="toast-body pt-0 pb-3 bg-white">

            <!-- Progress Text -->
            <div class="d-flex justify-content-between align-items-center mb-1">

                <span id="syncText"
                      class="text-muted small">
                    Preparing sync...
                </span>

                <span id="syncPercentText"
                      class="small fw-bold">
                    0%
                </span>

            </div>

            <!-- Progress Bar -->
            <div class="progress"
                 style="height:4px;">
                <div id="syncProgressBar"
                     class="progress-bar"
                     role="progressbar"
                     style="width:0%; background-color:var(--primary-container);"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="0">

                </div>

            </div>

        </div>

    </div>

</div>
