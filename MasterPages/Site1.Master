<header class="top-navbar px-3 px-lg-4 px-xl-5 py-1" id="masterHeader">
<div class="container-fluid p-0">
<div class="d-flex align-items-center w-100 justify-content-between">

<!-- LEFT SIDE -->
<div class="d-flex align-items-center gap-2 gap-sm-3">

<button class="btn btn-light border"
id="sidebarCollapse"
type="button">
<i class="bi bi-list fs-4"></i>
</button>

<div class="master-app-title">
<div class="master-app-name">Mobile Inspection</div>
<div class="master-app-company"><span id="lblCompany"></span></div>
</div>
<div id="connectionStatus">
<%--<div class="vr d-none d-md-block mx-2" style="height: 16px;"></div>--%>

<div class="d-none d-md-flex align-items-center text-muted small flex-shrink-0">
<i class="bi bi-circle-fill text-success me-1"
style="font-size: 8px;"></i>
<span id="lblConnection"></span>
</div>

</div>
</div>

<!-- RIGHT SIDE -->
<div class="d-flex align-items-center gap-2 gap-md-3">

<!-- Sync Button -->
<button class="btn primary-gradient-btn rounded-pill px-3 px-md-4 fw-bold small d-flex align-items-center gap-2 flex-shrink-0 position-relative"
id="btnSync">

<i class="bi bi-arrow-repeat"></i>

<span id="badgePendingSync"
class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
0
</span>

<span id="inspectionConflictBadge" class="position-absolute top-0 start-0 translate-middle badge rounded-pill text-bg-danger d-none" title="Inspection conflict">!</span>

</button>

<!-- USER PROFILE BUTTON -->
<button class="btn primary-gradient-btn border rounded-circle d-flex align-items-center justify-content-center bg-transparent" id="btnProfileTopBar" type="button" style="width: 40px; height: 40px;">
<i class="bi bi-person-circle"></i>
</button>

</div>

</div>
<div id="pageStickyBar" runat="server">
<asp:ContentPlaceHolder ID="stickybar" runat="server"></asp:ContentPlaceHolder>
<asp:Panel ID="pnl_TB" runat="server" Visible="false" CssClass="mt-2">
    <uc2:UC_Toolbar_2 ID="ucToolbar" runat="server" />
</asp:Panel>
</div>
</div>
</header>
<!-- Dashboard Body -->
<form id="form1" runat="server">
<asp:HiddenField ID="hfMnCompanyID" ClientIDMode="Static" runat="server" />
<asp:HiddenField ID="hfMnLocationID" ClientIDMode="Static" runat="server" />
<asp:HiddenField ID="hfMnCompanyName" ClientIDMode="Static" runat="server" />
<asp:HiddenField ID="hfMnEmployeeID" ClientIDMode="Static" runat="server" />
<asp:HiddenField ID="hfMnMPPosition" ClientIDMode="Static" runat="server" />
<asp:HiddenField ID="hfMnIsByPassLogonUser" ClientIDMode="Static" runat="server" />
<asp:HiddenField ID="hfLegacyLoginData" ClientIDMode="Static" runat="server" />

<%--<div class="container-fluid px-3 px-lg-4 px-xl-5 py-4" id="contentbody" style="margin-top: 38px;">--%>
<div class="container-fluid px-3 px-lg-4 px-xl-5 py-2" id="contentbody">
<asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
<!-- Footer -->
<footer class="master-footer mt-auto">
    <div class="master-footer-line">
        <span>© Global Utility Services</span>
        <span>Version 4.2.0-STABLE</span>
        <span>Connection: <strong id="footerConnection">Offline</strong></span>
    </div>
</footer>
</div>
</form>
</div>
<!-- Global Floating Confirmation -->
<div id="globalConfirmOverlay" class="custom-overlay d-none">
    <div class="confirmation-dialog">

        <div class="icon-circle premium-gradient shadow-lg">
            <i class="bi bi-question-lg"></i>
        </div>

        <h3 id="confirmTitle" class="fw-bold mb-3">
            Confirm
        </h3>

        <p id="confirmMessage"
           class="text-muted px-2 mb-4 leading-relaxed">
            Are you sure?
        </p>

        <div class="row g-2">

            <div class="col-12 col-sm-6 order-2 order-sm-1">
                <button id="btnConfirmCancel"
                        class="btn btn-light w-100 rounded-pill py-3 fw-bold text-uppercase small shadow-sm">
                    Cancel
                </button>
            </div>

            <div class="col-12 col-sm-6 order-1 order-sm-2">
                <button id="btnConfirmYes"
                        class="btn premium-gradient w-100 rounded-pill py-3 fw-bold text-uppercase small shadow-lg">
                    Yes
                </button>
            </div>

        </div>

    </div>
</div>

</div>
<script type="text/javascript" src="../JSCus/GFC_FO.js?v=20261110-inspection-sync-no-pdf-1"></script>
<script type="text/javascript">
(function () {
    var field = document.getElementById("hfLegacyLoginData");
    if (!field || !field.value) return;

    try {
        var d = JSON.parse(field.value);
        if (!d || d.success !== true) return;

        var loginData = {
            userid: d.userid || "",
            browserGuid: d.browserGuid || "",
            serverGuid: d.serverguid || "",
            token: d.token || "",
            username: d.username || "",
            curcompany: d.curcompany || "",
            companylist: d.companylist || [],
            curcompanyname: d.curcompanyname || "",
            employeeid: d.employeeid || "",
            menus: d.menus || [],
            role: d.role,
            jobtitle: d.jobtitle || "",
            email: d.email || "",
            profitcenter: d.profitcenter || "",
            theme: d.theme || "L",
            section: d.section || "",
            lastsyncw: d.lastsyncw || "",
            lastMeterPeriod: "",
            lastMeterSync: "1900-01-02"
        };

        setLoginData(loginData);
        initIndexedDB().then(function () {
            return saveCompanyList(loginData.companylist);
        }).then(function () {
            var parts = (loginData.curcompany || "").split(";");
            if (parts.length === 2 && parts[0] && parts[1])
                return setLastSyncData(parts[0], parts[1]);
        }).catch(function (error) {
            console.error("Unable to initialize legacy INSPEC login data:", error);
        });
    } catch (error) {
        console.error("Unable to restore legacy INSPEC login data:", error);
    }
})();
</script>
<script type="text/javascript" src="../JSCus/inspectionApprovalSync.js"></script>
<script type="text/javascript" src="../JSCus/Site1.Master.js"></script>
<%--<script type="text/javascript" src="/WebFolder/bootstrap-5.3.0-dist/js/bootstrap.bundle.min.js"></script>--%>

