<%@ Page Language="C#" AutoEventWireup="true" MasterPageFile="~/MasterPages/Site_BS_5.Master" CodeBehind="M_LightingMapEditor.aspx.cs" Inherits="INSPEC.Secure.M_LightingMapEditor" %>
<%@ MasterType VirtualPath="~/MasterPages/Site_BS_5.Master" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
<style type="text/css">
.me{font:13px Arial,sans-serif;color:#253a4a;padding:14px;background:#f5f7fa}.me *{box-sizing:border-box}.me-panel{background:#fff;border:1px solid #dbe3eb;border-radius:8px;padding:14px;margin-bottom:12px}.me-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(290px,1fr);gap:12px}.me-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:10px 0}.me button,.me select{border:1px solid #c8d5df;background:#fff;border-radius:5px;padding:8px;cursor:pointer}.me button:disabled{opacity:.45;cursor:default}.me button.primary{background:#167d9e;color:#fff}.me button.danger{color:#ae3030}.me-canvas{height:570px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#e9eff3;border:1px solid #d9e2ea;border-radius:6px}.me-canvas svg{display:block;max-width:100%;max-height:100%;overflow:visible}.me-shape{cursor:pointer}.me-shape.selected{filter:drop-shadow(0 0 3px #2563eb)}.me-shape:focus{outline:none;stroke:#2563eb}.me-list{height:490px;overflow:auto;border:1px solid #e0e7ed;border-radius:6px}.me-entry{display:flex;align-items:center;justify-content:space-between;padding:9px;border-bottom:1px solid #e8edf1;cursor:pointer;gap:6px}.me-entry.selected{background:#e8f4ff}.me-muted{color:#697c8c;font-size:12px}.me-chip{padding:3px 6px;border-radius:4px;background:#edf1f5;font-size:11px}.me-hidden{opacity:.52}.me-note{font-size:12px;color:#697c8c}.me-status{min-height:20px}.me-error{color:#a52828}@media(max-width:850px){.me-layout{grid-template-columns:1fr}.me-canvas{height:390px}.me-list{height:280px}.me{padding:6px}}
</style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="me" id="mapEditor">
 <div class="me-panel"><h2 style="margin:0 0 6px">Lighting Map Editor</h2><div class="me-muted">Pilih elemen SVG, lalu Hide / Show / Delete / Restore. Perubahan baru berlaku setelah Save.</div><div class="me-bar"><label for="meMap">Denah</label><select id="meMap"></select><button type="button" id="meZoomOut">−</button><button type="button" id="meZoomIn">+</button><button type="button" id="meZoomReset">Reset Zoom</button><span id="meZoomLabel" class="me-muted"></span></div><div class="me-status" id="meStatus" aria-live="polite"></div></div>
 <div class="me-layout"><div class="me-panel"><div id="meCanvas" class="me-canvas"></div><div class="me-note" style="margin-top:8px">Jalur yang hidden/deleted tetap bisa dipilih dari daftar elemen. Gambar denah tidak diubah.</div></div><div class="me-panel"><strong>Elemen SVG</strong><div class="me-bar"><label for="meFilter">Filter</label><select id="meFilter"><option value="all">Semua</option><option value="visible">Visible</option><option value="hidden">Hidden</option><option value="deleted">Deleted</option></select></div><div id="meList" class="me-list"></div><div class="me-bar"><button type="button" id="meHide">Hide</button><button type="button" id="meShow">Show</button><button type="button" id="meDelete" class="danger">Delete</button><button type="button" id="meRestore">Restore</button></div><div class="me-bar"><button type="button" id="meUndo">Undo</button><button type="button" id="meDiscard">Discard All</button><button type="button" id="meSave" class="primary">Save Changes</button></div><div id="meDirty" class="me-muted"></div></div></div>
 <asp:HiddenField ID="hfEditorChanges" runat="server" /><asp:LinkButton ID="btnEditorSave" runat="server" OnClick="btnEditorSave_Click" CausesValidation="false" Style="display:none" />
</div>
<script type="text/javascript">
(function(){
 var root=document.getElementById('mapEditor');if(!root)return;
 var initial=<%= InitialJson %>,maps=initial.maps||[],items=initial.paths||[],canEdit=initial.canEdit===true;
 var saving=false;var mapId=maps.length?Number(maps[0].MapID):null,selected=null,zoom=1,changes={},undo=[];
 function id(s){return document.getElementById(s);}function num(x){return Number(x);}function active(p){return !p.IsDeleted&&p.IsVisible;}function current(p){var c=changes[p.MapPathID];return c?{IsVisible:c.IsVisible,IsDeleted:c.IsDeleted}:p;}
 function setStatus(s,error){id('meStatus').textContent=s||'';id('meStatus').className=error?'me-status me-error':'me-status';}
 function map(){for(var i=0;i<maps.length;i++)if(num(maps[i].MapID)===mapId)return maps[i];return null;}
 function list(){var box=id('meList');box.innerHTML='';var filter=id('meFilter').value,count=0;items.forEach(function(p){if(num(p.MapID)!==mapId)return;var s=current(p),state=s.IsDeleted?'deleted':(!s.IsVisible?'hidden':'visible');if(filter!=='all'&&filter!==state)return;count++;var row=document.createElement('div');row.className='me-entry'+(num(p.MapPathID)===selected?' selected':'')+(state!=='visible'?' me-hidden':'');var label=document.createElement('span');label.textContent=(p.ElementID||('#'+p.MapPathID))+' · '+p.ShapeType+' · Light '+p.LightID;var chip=document.createElement('span');chip.className='me-chip';chip.textContent=state.toUpperCase()+(changes[p.MapPathID]?' *':'');row.appendChild(label);row.appendChild(chip);row.onclick=function(){selected=num(p.MapPathID);render();};box.appendChild(row);});if(!count)box.textContent='Tidak ada elemen untuk filter ini.';}
 function svgElement(tag){return document.createElementNS('http://www.w3.org/2000/svg',tag);}
 function renderMap(){var holder=id('meCanvas');holder.innerHTML='';var m=map();if(!m)return;var svg=svgElement('svg');svg.setAttribute('viewBox',[m.ViewBoxX,m.ViewBoxY,m.ViewBoxWidth,m.ViewBoxHeight].join(' '));svg.setAttribute('width',m.ViewBoxWidth);svg.setAttribute('height',m.ViewBoxHeight);svg.style.transform='scale('+zoom+')';svg.style.transformOrigin='center';var bg=svgElement('rect');bg.setAttribute('x',m.ViewBoxX);bg.setAttribute('y',m.ViewBoxY);bg.setAttribute('width',m.ViewBoxWidth);bg.setAttribute('height',m.ViewBoxHeight);bg.setAttribute('fill','#edf1f4');svg.appendChild(bg);if(m.ImagePath){var img=svgElement('image');img.setAttribute('href',m.ImagePath);img.setAttribute('x',m.ViewBoxX);img.setAttribute('y',m.ViewBoxY);img.setAttribute('width',m.ViewBoxWidth);img.setAttribute('height',m.ViewBoxHeight);img.setAttribute('preserveAspectRatio','none');svg.appendChild(img);}items.filter(function(p){return num(p.MapID)===mapId&&active(current(p));}).sort(function(a,b){return (a.ShapeType==='PATH'?0:1)-(b.ShapeType==='PATH'?0:1)||num(a.DisplayOrder)-num(b.DisplayOrder);}).forEach(function(p){if(p.ShapeType!=='PATH'&&p.ShapeType!=='CIRCLE')return;var sel=num(p.MapPathID)===selected;var shape=svgElement(p.ShapeType==='PATH'?'path':'circle');shape.setAttribute('class','me-shape'+(sel?' selected':''));if(p.ShapeType==='PATH'){shape.setAttribute('d',p.SvgPathData||'');shape.setAttribute('fill','none');shape.setAttribute('stroke',sel?'#2563eb':'#687f90');shape.setAttribute('stroke-width',sel?Math.max(3,num(p.StrokeWidth)||2):Math.max(1,num(p.StrokeWidth)||2));shape.setAttribute('stroke-linecap','round');shape.setAttribute('stroke-linejoin','round');}else{var a={};try{a=JSON.parse(p.ShapeAttributes||'{}');}catch(e){};shape.setAttribute('cx',num(a.cx)||0);shape.setAttribute('cy',num(a.cy)||0);shape.setAttribute('r',Math.max(2,num(a.r)||3));shape.setAttribute('fill',sel?'#2563eb':'#16834a');shape.setAttribute('stroke','#fff');shape.setAttribute('stroke-width',sel?'2.5':'1.5');}shape.setAttribute('tabindex','0');shape.setAttribute('role','button');var title=svgElement('title');title.textContent=(p.ElementID||p.MapPathID)+' · Light '+p.LightID;shape.appendChild(title);shape.onclick=function(){selected=num(p.MapPathID);render();};shape.onkeydown=function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();selected=num(p.MapPathID);render();}};svg.appendChild(shape);});holder.appendChild(svg);id('meZoomLabel').textContent=Math.round(zoom*100)+'%';}
 function render(){renderMap();list();var p=items.filter(function(x){return num(x.MapPathID)===selected&&num(x.MapID)===mapId;})[0],s=p?current(p):null;id('meHide').disabled=!canEdit||!s||s.IsDeleted||!s.IsVisible;id('meShow').disabled=!canEdit||!s||s.IsDeleted||!!s.IsVisible;id('meDelete').disabled=!canEdit||!s||!!s.IsDeleted;id('meRestore').disabled=!canEdit||!s||!s.IsDeleted;id('meUndo').disabled=!canEdit||!undo.length;id('meDiscard').disabled=!canEdit||!Object.keys(changes).length;id('meSave').disabled=!canEdit||!Object.keys(changes).length;id('meDirty').textContent=Object.keys(changes).length+' elemen berubah (belum disimpan)';}
 function change(action){var p=items.filter(function(x){return num(x.MapPathID)===selected;})[0];if(!p||!canEdit)return;if(action==='DELETE'&&!confirm('Soft delete elemen '+(p.ElementID||p.MapPathID)+'?'))return;undo.push(JSON.stringify(changes));var s=current(p),v=!!s.IsVisible,d=!!s.IsDeleted;if(action==='HIDE')v=false;if(action==='SHOW')v=true;if(action==='DELETE')d=true;if(action==='RESTORE')d=false;if(v===!!p.IsVisible&&d===!!p.IsDeleted)delete changes[p.MapPathID];else changes[p.MapPathID]={MapID:num(p.MapID),MapPathID:num(p.MapPathID),IsVisible:v,IsDeleted:d};render();}
 function pendingActions(){var out=[];Object.keys(changes).forEach(function(k){var p=items.filter(function(x){return String(x.MapPathID)===k;})[0],s=changes[k];if(!p)return;/* visibility and deletion may require two SP calls */if(!!p.IsDeleted!==!!s.IsDeleted){out.push({MapID:num(p.MapID),MapPathID:num(p.MapPathID),ActionType:s.IsDeleted?'DELETE':'RESTORE'});}if(!!p.IsVisible!==!!s.IsVisible){out.push({MapID:num(p.MapID),MapPathID:num(p.MapPathID),ActionType:s.IsVisible?'SHOW':'HIDE'});}});return out;}
 maps.forEach(function(m){var opt=document.createElement('option');opt.value=m.MapID;opt.textContent=m.MapName;id('meMap').appendChild(opt);});id('meMap').onchange=function(){mapId=num(this.value);selected=null;zoom=1;render();};id('meFilter').onchange=list;
 ['Hide','Show','Delete','Restore'].forEach(function(a){id('me'+a).onclick=function(){change(a.toUpperCase());};});id('meUndo').onclick=function(){if(undo.length){changes=JSON.parse(undo.pop());render();}};id('meDiscard').onclick=function(){if(confirm('Batalkan seluruh perubahan yang belum disimpan?')){changes={};undo=[];render();}};
 id('meSave').onclick=function(){if(!canEdit)return;var actions=pendingActions();if(!actions.length)return;if(!confirm('Simpan '+actions.length+' operasi mapping?'))return;id('<%= hfEditorChanges.ClientID %>').value=JSON.stringify(actions);saving=true;id('<%= btnEditorSave.ClientID %>').click();};
 id('meZoomIn').onclick=function(){zoom=Math.min(3,zoom+.25);renderMap();};id('meZoomOut').onclick=function(){zoom=Math.max(.5,zoom-.25);renderMap();};id('meZoomReset').onclick=function(){zoom=1;renderMap();};
 window.addEventListener('beforeunload',function(e){if(!saving&&Object.keys(changes).length){e.preventDefault();e.returnValue='';}});
 if(!canEdit)setStatus('Akses editor belum diberikan. Hubungkan role INSPEC_LightingMapEditor pada sistem otorisasi.',true);render();
})();
</script>
</asp:Content>
